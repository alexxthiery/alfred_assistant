#!/usr/bin/env bash
# pre-commit — block commits that leak PII or break the fixture suite.
#
# Install:
#   ln -sfn ../../tools/pre-commit .git/hooks/pre-commit
#   # If you have a global core.hooksPath, override per-repo:
#   git config --local core.hooksPath .git/hooks
#
# Runs in two stages:
#   1. tools/scan-pii.sh on every staged text file — abort if any hit.
#   2. bin/wiki-test, ONLY if a staged file is under bin/, tests/, schemas/,
#      or docs/SCHEMA.md (i.e., could affect the fixture suite). Skipped for
#      doc-only commits to keep them fast.

set -euo pipefail

REPO=$(git rev-parse --show-toplevel)
SCAN="$REPO/tools/scan-pii.sh"
PII="$REPO/tools/pii-list.local.txt"

if [ ! -x "$SCAN" ]; then
  echo "pre-commit: missing or non-executable $SCAN" >&2
  exit 1
fi
if [ ! -f "$PII" ]; then
  echo "pre-commit: missing $PII (your local PII list — gitignored)" >&2
  echo "  Build one with the patterns specific to your private content." >&2
  exit 1
fi

# Collect staged text files
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | \
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    # skip binaries with `file` heuristic
    if file --mime "$f" 2>/dev/null | grep -q 'charset=binary'; then continue; fi
    echo "$f"
  done)

if [ -z "$STAGED" ]; then
  exit 0
fi

HITS=0
HIT_OUT=""
while IFS= read -r f; do
  # Attribution files exempt from the PII scan: the maintainer's real name
  # belongs in the copyright/credits by design, so scanning them for "names"
  # would block the one place a name is supposed to appear.
  case "$f" in
    LICENSE|CONTRIBUTORS.md) continue ;;
  esac
  out=$("$SCAN" "$REPO/$f" 2>&1 || true)
  if echo "$out" | grep -q "HIT"; then
    HITS=1
    HIT_OUT="${HIT_OUT}${out}\n"
  fi
done <<< "$STAGED"

if [ "$HITS" -eq 1 ]; then
  echo "pre-commit: PII scanner found matches in staged files:" >&2
  printf '%b' "$HIT_OUT" >&2
  echo "" >&2
  echo "Abort. Either:" >&2
  echo "  (a) redact the offending content, or" >&2
  echo "  (b) if it's a false positive, add the pattern's category exclusion to tools/build-pii-list.sh and regenerate." >&2
  exit 1
fi

# --- Test suite (unit + fixtures) ---
# Run if any staged file is under bin/, tests/, schemas/, or docs/SCHEMA.md.
# Skip otherwise so doc-only commits stay fast.
WIKI_TEST="$REPO/bin/wiki-test"
RELEVANT=0
while IFS= read -r f; do
  case "$f" in
    bin/*|tests/*|schemas/*|docs/SCHEMA.md) RELEVANT=1 ;;
  esac
done <<< "$STAGED"

if [ "$RELEVANT" -eq 1 ]; then
  # Unit tests first (fast; ~100ms). Only if any unit-test files exist.
  if ls "$REPO"/tests/unit/*.test.js >/dev/null 2>&1; then
    if ! (cd "$REPO" && node --test 'tests/unit/*.test.js' >/dev/null 2>&1); then
      echo "pre-commit: unit tests failed. Run directly to see which:" >&2
      echo "  cd $REPO && node --test 'tests/unit/*.test.js'" >&2
      exit 1
    fi
  fi
  # Fixture suite (slower; full vault per test).
  if [ -x "$WIKI_TEST" ]; then
    if ! "$WIKI_TEST" >/dev/null 2>&1; then
      echo "pre-commit: bin/wiki-test failed. Run it directly to see which fixtures broke:" >&2
      echo "  $WIKI_TEST" >&2
      exit 1
    fi
  fi
fi

exit 0
