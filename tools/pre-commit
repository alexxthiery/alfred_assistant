#!/usr/bin/env bash
# pre-commit — block commits that leak PII or break the fixture suite.
#
# Install:
#   ln -sfn ../../tools/pre-commit .git/hooks/pre-commit
#   # If you have a global core.hooksPath, override per-repo:
#   git config --local core.hooksPath .git/hooks
#
# Also usable from other repos (e.g. the NanoClaw checkout): symlink this
# file into that repo's .git/hooks/. Scanner + PII list resolve relative to
# this script's real location; the test stage only runs in alfred_assistant.
#
# Runs in two stages:
#   1. Rebuild tools/pii-list.local.txt from the vaults (best effort: keeps
#      the existing list if no vault is readable), then scan the staged
#      blobs with tools/scan-pii.js — abort on any hit.
#   2. bin/wiki-test, ONLY if a staged file is under bin/, tests/, schemas/,
#      or docs/SCHEMA.md (i.e., could affect the fixture suite). Skipped for
#      doc-only commits to keep them fast.

set -euo pipefail

REPO=$(git rev-parse --show-toplevel)
SELF=$(node -p 'require("fs").realpathSync(process.argv[1])' "${BASH_SOURCE[0]}")
TOOLS=$(dirname "$SELF")
ALFRED=$(dirname "$TOOLS")
PII="$TOOLS/pii-list.local.txt"

node "$TOOLS/build-pii-list.js" --quiet || \
  echo "pre-commit: PII list not rebuilt; scanning with the existing one" >&2
if [ ! -f "$PII" ]; then
  echo "pre-commit: missing $PII (your local PII list — gitignored)" >&2
  echo "  List vault paths in $TOOLS/pii-vaults.local.txt, then run tools/build-pii-list.js." >&2
  exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED" ]; then
  exit 0
fi

set +e
HIT_OUT=$(cd "$REPO" && node "$TOOLS/scan-pii.js" --staged 2>&1)
SCAN_RC=$?
set -e
if [ "$SCAN_RC" -ne 0 ]; then
  echo "pre-commit: PII scanner refused the staged files:" >&2
  printf '%s\n' "$HIT_OUT" >&2
  echo "" >&2
  echo "Abort. Either:" >&2
  echo "  (a) redact the offending content, or" >&2
  echo "  (b) if it's a public name (false positive), add it to $TOOLS/pii-allow.local.txt." >&2
  exit 1
fi

# Tests belong to alfred_assistant only.
if [ "$(cd "$REPO" && pwd -P)" != "$(cd "$ALFRED" && pwd -P)" ]; then
  exit 0
fi

# --- Test suite (unit + fixtures) ---
# Run if any staged file is under bin/, tests/, schemas/, or docs/SCHEMA.md.
# Skip otherwise so doc-only commits stay fast.
WIKI_TEST="$REPO/bin/wiki-test"
RELEVANT=0
while IFS= read -r f; do
  case "$f" in
    bin/*|tests/*|schemas/*|docs/SCHEMA.md) RELEVANT=1 ;;
  esac
done <<< "$STAGED"

if [ "$RELEVANT" -eq 1 ]; then
  # Unit tests first (fast; ~100ms). Only if any unit-test files exist.
  if ls "$REPO"/tests/unit/*.test.js >/dev/null 2>&1; then
    if ! (cd "$REPO" && node --test 'tests/unit/*.test.js' >/dev/null 2>&1); then
      echo "pre-commit: unit tests failed. Run directly to see which:" >&2
      echo "  cd $REPO && node --test 'tests/unit/*.test.js'" >&2
      exit 1
    fi
  fi
  # Fixture suite (slower; full vault per test).
  if [ -x "$WIKI_TEST" ]; then
    if ! "$WIKI_TEST" >/dev/null 2>&1; then
      echo "pre-commit: bin/wiki-test failed. Run it directly to see which fixtures broke:" >&2
      echo "  $WIKI_TEST" >&2
      exit 1
    fi
  fi
fi

exit 0
