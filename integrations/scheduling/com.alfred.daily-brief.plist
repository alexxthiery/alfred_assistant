<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the deterministic daily brief (07:00 local).
  Install:
    Prefer tools/install-assistant-jobs.sh --brief 07:00, which stamps
    machine-specific paths into ~/Library/LaunchAgents.

    Manual fallback:
    1. Edit ALFRED_VAULT / ALFRED_ASSISTANT_LABEL / ENV_FILE / PATH below and the path to run-daily-brief.sh.
    2. cp to ~/Library/LaunchAgents/com.alfred.daily-brief.plist
    3. launchctl load ~/Library/LaunchAgents/com.alfred.daily-brief.plist
  Secrets are NOT in this file — run-daily-brief.sh sources them from ENV_FILE.
  ENV_FILE must also contain ALFRED_EXPECTED_VAULT and ALFRED_EXPECTED_LABEL.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.alfred.daily-brief</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/alfred_assistant/integrations/scheduling/run-daily-brief.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ALFRED_VAULT</key><string>/Users/YOU/my-vault</string>
    <key>ALFRED_ASSISTANT_LABEL</key><string>alfred</string>
    <key>ENV_FILE</key><string>/Users/YOU/my-vault/.alfred/private/env</string>
    <key>PATH</key><string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/com.alfred.daily-brief.out</string>
  <key>StandardErrorPath</key><string>/tmp/com.alfred.daily-brief.err</string>
</dict>
</plist>
