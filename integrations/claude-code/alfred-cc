#!/usr/bin/env bash
# alfred-cc — launch Claude Code as Alfred against your vault.
#
# cd's into the vault (so Claude Code loads <vault>/CLAUDE.md → @AGENTS.md) and
# runs `claude`. Set ALFRED_VAULT to your vault path, or edit the default below.
# Any extra args pass through to claude (e.g. `alfred-cc -p "..."`).
set -euo pipefail
VAULT="${ALFRED_VAULT:-$HOME/Library/CloudStorage/Dropbox/_AI_box}"
[ -f "$VAULT/AGENTS.md" ] || { echo "alfred-cc: no AGENTS.md in $VAULT (set ALFRED_VAULT)" >&2; exit 1; }
cd "$VAULT"
exec claude "$@"
