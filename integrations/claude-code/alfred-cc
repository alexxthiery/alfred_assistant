#!/usr/bin/env bash
# alfred-cc — launch Claude Code as Alfred against your vault.
#
# cd's into the vault (so Claude Code loads <vault>/CLAUDE.md → @AGENTS.md) and
# runs `claude`. Set ALFRED_VAULT to your vault path, or edit the default below.
# Any extra args pass through to claude (e.g. `alfred-cc -p "..."`).
set -euo pipefail
VAULT="${ALFRED_VAULT:-$HOME/my-vault}"
[ -f "$VAULT/AGENTS.md" ] || { echo "alfred-cc: no AGENTS.md in $VAULT (set ALFRED_VAULT)" >&2; exit 1; }
# Put the deployed CLI on PATH so the persona's bare `wiki`/`inbox` resolve.
[ -d "$VAULT/.bin" ] && export PATH="$VAULT/.bin:$PATH"
# Disable the RTK rewrite hook for this session so Alfred gets raw CLI/file
# output (RTK compacts ls/cat/wiki output, which corrupts what the agent reads).
# Honored by ~/.claude/hooks/rtk-gate.sh; harmless if that gate is not installed.
export ALFRED_NO_RTK=1
cd "$VAULT"
exec claude "$@"
