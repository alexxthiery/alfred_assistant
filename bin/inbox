#!/usr/bin/env node
// inbox — ingestion CLI for the vault.
// Verbs: triage, queue, ack, list, ingest-url.
// No deps. Node stdlib only.

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const https = require('https');
const http = require('http');
const { URL } = require('url');

// HR11: detectVaultRoot is shared with bin/lib/vault.js via bin/lib/vault-root.js
// (standalone module — bin/inbox doesn't require the wider vault.js dep tree).
const { detectVaultRoot } = require(path.resolve(__dirname, 'lib', 'vault-root.js'));

const VAULT_ROOT = detectVaultRoot();
const INBOX_DIR = path.join(VAULT_ROOT, 'inbox');
const PROCESSED_DIR = path.join(INBOX_DIR, '_processed');
const RAW_DIR = path.join(VAULT_ROOT, 'raw');
const PENDING_PATH = path.join(RAW_DIR, '_pending.md');

const nowISO = () => new Date().toISOString();
const todayDate = () => nowISO().slice(0, 10);

// --- slug / sha ------------------------------------------------------------

function slugify(filename) {
  const base = path.basename(filename, path.extname(filename));
  return base
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 80) || 'untitled';
}

function uniqueSlug(dir, slug) {
  let candidate = slug;
  let n = 2;
  while (fs.existsSync(path.join(dir, `${candidate}.md`))) {
    candidate = `${slug}-${n}`;
    n++;
  }
  return candidate;
}

function sha256(buf) {
  return crypto.createHash('sha256').update(buf).digest('hex');
}

// --- file kind / extraction ------------------------------------------------

function detectKind(filePath) {
  const ext = path.extname(filePath).toLowerCase();
  if (ext === '.md' || ext === '.markdown') return 'notes';
  if (ext === '.txt') return 'notes';
  if (ext === '.html' || ext === '.htm') return 'clippings';
  return null; // unsupported
}

function htmlToMarkdown(html) {
  // Minimal HTML → md: strip script/style, decode common entities,
  // map a few block tags to markdown, collapse whitespace.
  let s = html;
  s = s.replace(/<script[\s\S]*?<\/script>/gi, '');
  s = s.replace(/<style[\s\S]*?<\/style>/gi, '');
  s = s.replace(/<!--[\s\S]*?-->/g, '');
  s = s.replace(/<title[^>]*>([\s\S]*?)<\/title>/i, (_, t) => `# ${t.trim()}\n\n`);
  s = s.replace(/<\/(p|div|section|article)>/gi, '\n\n');
  s = s.replace(/<h([1-6])[^>]*>([\s\S]*?)<\/h\1>/gi, (_, n, t) => `\n\n${'#'.repeat(+n)} ${t.trim()}\n\n`);
  s = s.replace(/<li[^>]*>([\s\S]*?)<\/li>/gi, (_, t) => `- ${t.trim()}\n`);
  s = s.replace(/<a [^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/gi, (_, href, t) => `[${t.trim()}](${href})`);
  s = s.replace(/<br\s*\/?>/gi, '\n');
  s = s.replace(/<[^>]+>/g, ''); // strip remaining tags
  s = s.replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
  s = s.replace(/\n{3,}/g, '\n\n').trim();
  return s;
}

function extractText(filePath, kind) {
  const buf = fs.readFileSync(filePath);
  if (kind === 'clippings') {
    return htmlToMarkdown(buf.toString('utf-8'));
  }
  return buf.toString('utf-8');
}

// --- secret redaction ------------------------------------------------------

// Patterns are best-effort. False negatives are possible; do not rely on this for
// strong sanitization of highly sensitive material. SCHEMA.md notes this.
const REDACTION_PATTERNS = [
  // Generic key=value style (api_key, secret, token, bearer, password)
  /(?<prefix>(?:api[_-]?key|secret|token|bearer|password|passwd)\s*[:=]\s*['"]?)(?<value>[^\s'"\n]{8,})/gi,
  // Provider-specific token formats
  /\bsk-[a-zA-Z0-9-]{20,}\b/g,        // OpenAI / Anthropic
  /\bsk-ant-[a-zA-Z0-9-_]{20,}\b/g,   // Anthropic
  /\bghp_[a-zA-Z0-9]{36}\b/g,         // GitHub PAT
  /\bgho_[a-zA-Z0-9]{36}\b/g,         // GitHub OAuth
  /\bxox[bpas]-[0-9a-zA-Z-]{10,}\b/g, // Slack
  /\bAKIA[0-9A-Z]{16}\b/g,            // AWS access key
  /\b[A-Za-z0-9/+=]{40}\b(?=\s*['"]?\s*$)/gm, // AWS secret-key shape on its own line (loose)
];

function redact(text) {
  let count = 0;
  let out = text;
  for (const re of REDACTION_PATTERNS) {
    out = out.replace(re, (match, ...args) => {
      count++;
      // If match has a "prefix" capture, preserve the prefix and replace the value
      const groups = args[args.length - 1];
      if (groups && groups.prefix) return `${groups.prefix}[REDACTED]`;
      return '[REDACTED]';
    });
  }
  return { text: out, count };
}

// --- frontmatter writer ----------------------------------------------------

function writeRawPage({ slug, kind, sourceFilename, sha, ingestedAt, body, originalSize, redactionCount }) {
  const fm = [
    '---',
    `id: ${slug}`,
    `title: ${sourceFilename}`,
    `type: source`,
    `created: ${ingestedAt}`,
    `updated: ${ingestedAt}`,
    `tags: []`,
    `kind: ${kind}`,
    `source_path: inbox/${sourceFilename}`,
    `sha256: ${sha}`,
    `ingested_at: ${ingestedAt}`,
    `original_size: ${originalSize}`,
    `redactions: ${redactionCount}`,
    '---',
    '',
  ].join('\n');
  const targetDir = path.join(RAW_DIR, kind);
  fs.mkdirSync(targetDir, { recursive: true });
  const filePath = path.join(targetDir, `${slug}.md`);
  fs.writeFileSync(filePath, fm + body + (body.endsWith('\n') ? '' : '\n'));
  return filePath;
}

function appendToPending(slug, kind) {
  fs.mkdirSync(RAW_DIR, { recursive: true });
  const line = `- ${kind}/${slug}\n`;
  if (!fs.existsSync(PENDING_PATH)) {
    fs.writeFileSync(PENDING_PATH, `# Pending sources\n\nOne entry per pending raw source. Alfred removes the line after processing.\n\n${line}`);
  } else {
    fs.appendFileSync(PENDING_PATH, line);
  }
}

function listActiveInboxFiles(dir = INBOX_DIR, prefix = '') {
  if (!fs.existsSync(dir)) return [];
  const out = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (entry.name.startsWith('.') || entry.name.startsWith('_')) continue;
    const rel = prefix ? `${prefix}/${entry.name}` : entry.name;
    const abs = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      out.push(...listActiveInboxFiles(abs, rel));
    } else if (entry.isFile()) {
      out.push(rel);
    }
  }
  return out.sort();
}

// --- verbs -----------------------------------------------------------------

function cmdTriage(args) {
  if (!fs.existsSync(INBOX_DIR)) {
    console.error(`Inbox does not exist: ${INBOX_DIR}`);
    process.exit(1);
  }
  const activeFiles = listActiveInboxFiles();
  const nestedFiles = activeFiles.filter((rel) => rel.includes('/'));
  if (nestedFiles.length > 0) {
    console.error('error: inbox contains nested active file(s); triage only processes files directly under inbox/:');
    for (const rel of nestedFiles.slice(0, 20)) console.error(`  inbox/${rel}`);
    if (nestedFiles.length > 20) console.error(`  ... ${nestedFiles.length - 20} more`);
    console.error('Move them to inbox/ root for triage, archive them under raw/<kind>/, or run wiki migrate-inbox-sources for referenced legacy inbox folders.');
    process.exit(2);
  }

  const entries = fs.readdirSync(INBOX_DIR, { withFileTypes: true })
    .filter((e) => e.isFile() && !e.name.startsWith('.') && !e.name.startsWith('_'));

  if (entries.length === 0) {
    console.log('(inbox empty)');
    return;
  }

  fs.mkdirSync(PROCESSED_DIR, { recursive: true });
  const archive = path.join(PROCESSED_DIR, todayDate());
  fs.mkdirSync(archive, { recursive: true });

  let processed = 0, skipped = 0;
  for (const entry of entries) {
    const src = path.join(INBOX_DIR, entry.name);
    const kind = detectKind(src);
    if (!kind) {
      console.log(`SKIP  ${entry.name} (unsupported kind; only .md/.txt/.html for now)`);
      skipped++;
      continue;
    }

    let text;
    try {
      text = extractText(src, kind);
    } catch (err) {
      console.log(`ERROR ${entry.name}: ${err.message}`);
      skipped++;
      continue;
    }

    const { text: redacted, count: redCount } = redact(text);
    const buf = Buffer.from(redacted, 'utf-8');
    const sha = sha256(buf);
    const baseSlug = `${todayDate()}-${slugify(entry.name)}`;
    const slug = uniqueSlug(path.join(RAW_DIR, kind), baseSlug);
    const stat = fs.statSync(src);
    const ingestedAt = nowISO();

    const rawPath = writeRawPage({
      slug, kind, sourceFilename: entry.name, sha, ingestedAt,
      body: redacted, originalSize: stat.size, redactionCount: redCount,
    });

    if (args['dry-run']) {
      fs.unlinkSync(rawPath);
      console.log(`DRY   ${entry.name} → ${kind}/${slug}.md  (sha ${sha.slice(0, 12)}, redactions ${redCount})`);
      continue;
    }

    // Move original to _processed/<date>/
    const archivePath = path.join(archive, entry.name);
    fs.renameSync(src, archivePath);
    appendToPending(slug, kind);

    console.log(`OK    ${entry.name} → ${kind}/${slug}.md  (sha ${sha.slice(0, 12)}, redactions ${redCount})`);
    processed++;
  }

  console.log(`\nDone: ${processed} processed, ${skipped} skipped.`);
  if (processed > 0) console.log(`Pending queue: ${PENDING_PATH}`);
}

function readPending() {
  if (!fs.existsSync(PENDING_PATH)) return [];
  const lines = fs.readFileSync(PENDING_PATH, 'utf-8').split('\n');
  return lines.filter((l) => l.startsWith('- ')).map((l) => l.replace(/^- /, '').trim()).filter(Boolean);
}

function writePending(entries) {
  const header = `# Pending sources\n\nOne entry per pending raw source. Alfred removes the line after processing.\n\n`;
  const body = entries.map((e) => `- ${e}`).join('\n') + (entries.length ? '\n' : '');
  fs.writeFileSync(PENDING_PATH, header + body);
}

function cmdQueue() {
  const entries = readPending();
  if (entries.length === 0) { console.log('(no pending sources)'); return; }
  for (const e of entries) {
    const p = path.join(RAW_DIR, `${e}.md`);
    const exists = fs.existsSync(p);
    console.log(`${e}${exists ? '' : '  (missing!)'}`);
  }
}

function cmdAck(args) {
  const slug = args._[0];
  if (!slug) { console.error('Usage: inbox ack <kind/slug>'); process.exit(1); }
  const entries = readPending();
  // accept either "kind/slug" or just "slug" (find unique match)
  let target = slug;
  if (!slug.includes('/')) {
    const matches = entries.filter((e) => e.endsWith(`/${slug}`));
    if (matches.length === 0) { console.error(`Not in pending queue: ${slug}`); process.exit(2); }
    if (matches.length > 1) { console.error(`Ambiguous; specify kind/slug. Matches: ${matches.join(', ')}`); process.exit(2); }
    target = matches[0];
  }
  const kept = entries.filter((e) => e !== target);
  if (kept.length === entries.length) { console.error(`Not in pending queue: ${target}`); process.exit(2); }
  writePending(kept);
  console.log(`acked: ${target}`);
}

function cmdList() {
  // List all raw sources with status (pending|processed)
  const pendingSet = new Set(readPending());
  const kinds = ['notes', 'clippings', 'transcripts'];
  let total = 0;
  for (const kind of kinds) {
    const dir = path.join(RAW_DIR, kind);
    if (!fs.existsSync(dir)) continue;
    const files = fs.readdirSync(dir).filter((f) => f.endsWith('.md')).sort();
    for (const f of files) {
      const slug = f.replace(/\.md$/, '');
      const key = `${kind}/${slug}`;
      const status = pendingSet.has(key) ? 'PENDING' : 'processed';
      console.log(`${status}\t${key}`);
      total++;
    }
  }
  if (total === 0) console.log('(no raw sources)');
}

// HTTP(S) GET with redirect follow, ~10s timeout. Returns { status, body, finalUrl, contentType }.
function fetchUrl(urlStr, opts = {}) {
  const maxRedirects = opts.maxRedirects ?? 5;
  return new Promise((resolve, reject) => {
    const visit = (url, redirectsLeft) => {
      const u = new URL(url);
      const lib = u.protocol === 'http:' ? http : https;
      const req = lib.get(u, {
        headers: {
          'User-Agent': 'nanoclaw-inbox/1.0 (+ingest)',
          'Accept': 'text/html,application/xhtml+xml,text/plain;q=0.9,*/*;q=0.5',
        },
        timeout: 10000,
      }, (res) => {
        const status = res.statusCode || 0;
        if (status >= 300 && status < 400 && res.headers.location && redirectsLeft > 0) {
          res.resume();
          const next = new URL(res.headers.location, url).toString();
          return visit(next, redirectsLeft - 1);
        }
        const chunks = [];
        res.on('data', (c) => chunks.push(c));
        res.on('end', () => {
          resolve({
            status,
            body: Buffer.concat(chunks).toString('utf-8'),
            finalUrl: url,
            contentType: res.headers['content-type'] || '',
          });
        });
      });
      req.on('error', reject);
      req.on('timeout', () => { req.destroy(new Error('request timeout')); });
    };
    visit(urlStr, maxRedirects);
  });
}

async function cmdIngestUrl(args) {
  const urlStr = args._[0];
  if (!urlStr) {
    console.error('Usage: inbox ingest-url <url> [--dry-run] [--slug <custom-slug>]');
    process.exit(1);
  }
  let url;
  try { url = new URL(urlStr); } catch { console.error(`Invalid URL: ${urlStr}`); process.exit(1); }
  if (!['http:', 'https:'].includes(url.protocol)) {
    console.error(`Only http(s) URLs supported: got ${url.protocol}`);
    process.exit(1);
  }

  console.log(`fetching ${url.toString()}...`);
  let res;
  try { res = await fetchUrl(url.toString()); }
  catch (err) { console.error(`fetch failed: ${err.message}`); process.exit(2); }
  if (res.status !== 200) {
    console.error(`HTTP ${res.status} from ${res.finalUrl}`);
    process.exit(2);
  }

  const ctype = res.contentType.toLowerCase();
  let text, kind;
  if (ctype.includes('text/html') || ctype.includes('application/xhtml')) {
    text = htmlToMarkdown(res.body);
    kind = 'clippings';
  } else if (ctype.startsWith('text/') || ctype.includes('markdown')) {
    text = res.body;
    kind = 'notes';
  } else {
    console.error(`Unsupported content-type: ${ctype}. Only text/html and text/* supported.`);
    process.exit(3);
  }

  // Apply secret redaction (URLs may contain tokens in query strings etc.)
  const { text: redacted, count: redCount } = redact(text);
  const buf = Buffer.from(redacted, 'utf-8');
  const sha = sha256(buf);

  // Slug from URL: domain + path slugified, plus date prefix
  const customSlug = args.slug;
  const baseSlug = customSlug || `${todayDate()}-${slugify(url.hostname + url.pathname)}`;
  const slug = uniqueSlug(path.join(RAW_DIR, kind), baseSlug);
  const ingestedAt = nowISO();

  // Frontmatter prepended manually to preserve the source_url field
  const fm = [
    '---',
    `id: ${slug}`,
    `title: ${url.toString()}`,
    `type: source`,
    `created: ${ingestedAt}`,
    `updated: ${ingestedAt}`,
    `tags: []`,
    `kind: ${kind}`,
    `source_url: ${url.toString()}`,
    `final_url: ${res.finalUrl}`,
    `sha256: ${sha}`,
    `ingested_at: ${ingestedAt}`,
    `content_type: ${res.contentType}`,
    `original_size: ${res.body.length}`,
    `redactions: ${redCount}`,
    '---',
    '',
  ].join('\n');

  if (args['dry-run']) {
    console.log(`DRY  ${url.toString()} → ${kind}/${slug}.md  (sha ${sha.slice(0, 12)}, redactions ${redCount}, ${redacted.length} chars)`);
    return;
  }

  const targetDir = path.join(RAW_DIR, kind);
  fs.mkdirSync(targetDir, { recursive: true });
  const filePath = path.join(targetDir, `${slug}.md`);
  fs.writeFileSync(filePath, fm + redacted + (redacted.endsWith('\n') ? '' : '\n'));
  appendToPending(slug, kind);

  console.log(`OK   ${url.toString()} → ${kind}/${slug}.md  (sha ${sha.slice(0, 12)}, redactions ${redCount})`);
  console.log(`Pending queue: ${PENDING_PATH}`);
}

// --- argparse + dispatch ---------------------------------------------------

function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const next = argv[i + 1];
      if (next !== undefined && !next.startsWith('--')) { out[key] = next; i++; }
      else out[key] = true;
    } else {
      out._.push(a);
    }
  }
  return out;
}

const verb = process.argv[2];
const args = parseArgs(process.argv.slice(3));
const cmds = { triage: cmdTriage, queue: cmdQueue, ack: cmdAck, list: cmdList, 'ingest-url': cmdIngestUrl };

if (!verb || !cmds[verb]) {
  console.error('inbox <verb> [args]');
  console.error('');
  console.error('  triage [--dry-run]              scan inbox/, redact secrets, write raw/, move originals');
  console.error('  ingest-url <url> [--dry-run] [--slug <s>]  fetch URL, redact, write raw/clippings/, queue');
  console.error('  queue                           list pending raw sources Alfred has not processed yet');
  console.error('  ack <kind/slug>                 remove a slug from the pending queue');
  console.error('  list                    list all raw sources with status');
  console.error('');
  console.error(`vault: ${VAULT_ROOT}`);
  process.exit(1);
}
Promise.resolve(cmds[verb](args)).catch((err) => {
  console.error(`error: ${err.message || err}`);
  process.exit(1);
});
