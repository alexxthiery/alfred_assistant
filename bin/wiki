    ].join('\n'),
  },
  { name: 'persona-lint', section: 'HYGIENE', lines: ['  persona-lint                              grep persona/schema/docs for unknown `wiki <verb>` references'] },
  { name: 'migrate',      section: 'HYGIENE', lines: ['  migrate [<slug>] [--dry-run]              apply pending SCHEMA_MIGRATIONS; stamps schema_version on unversioned pages'] },
  { name: 'preflight',    section: 'HYGIENE', lines: ['  preflight                                 smoke-test node/git/SCHEMA.md/duckdb/curl/SMTP/audit; one-command go/no-go'] },

  // SQL
  { name: 'sql', section: 'SQL', lines: [
    '  sql "<query>"                             run SQL against the `vault` table (DuckDB)',
    '  sql --schema                              describe the `vault` table',
    '  sql --explore                             open the DuckDB REPL on the DB',
    '  (DB at .cache/vault.duckdb; rebuilt lazily when any wiki/*.md is newer)',
  ] },

  // REPLAY
  { name: 'replay', section: 'REPLAY', lines: [
    '  replay <msg-id>                           re-run captured spec, diff vs captured result',
    '  replay --all                              walk all captures, summarize stable/drift',
    '  (captures live at raw/telegram-replay/<YYYY-MM>/ — auto-written when spec.msg_id is set)',
  ] },

  // REVIEW
  { name: 'review', section: 'REVIEW', lines: [
    '  review                                    Markdown digest of:',
    '                                            (1) independent mentions (promotion candidates)',
    '                                            (2) co-occurring slugs with no typed relation',
    '                                            (3) concept anchors missing (heavily-used tag, no canonical page)',
    '                                            (4) stale `[as-of]` / past-due `[until]` markers',
    '                                            (5) decisions without rationale',
    '                                            (6) orphan sources (ingested, never referenced)',
    '                                            (7) stale open todos (>60 days)',
  ] },

  // MEASUREMENTS
  { name: 'measure', section: 'MEASUREMENTS', lines: [
    '  measure <series> --date YYYY-MM-DD --field=value [...]',
    '                                           append a row to raw/measurements/<series>.tsv',
    '                                           and re-render the matching wiki page.',
    '                                           auto-derives bmi from height_m+weight_kg, age from --birth.',
    '  (pages with frontmatter `source_file:` cannot be patched/written — use this verb.)',
  ] },

  // GIT
  { name: 'diff',   section: 'GIT', lines: ['  diff [--since "spec"]                     show recent commits (default: 24h)'] },
  { name: 'revert', section: 'GIT', lines: [
    '  revert [<commit>|HEAD]                    revert a commit (refuses if working tree dirty)',
    '  (auto-commit batches all dirty files into one commit; revert may undo more than expected)',
  ] },

  // GLOBAL FLAGS (not real verbs; rendered last)
  { name: '__global', section: 'GLOBAL FLAGS', lines: [
    '  --no-auto-commit                          skip the post-write git commit (or set WIKI_NO_AUTO_COMMIT=1)',
    '  <verb> --help                             show detailed help for a verb (currently: ingest, write, patch, audit, lint)',
  ] },
];

function printGlobalHelp() {
  console.error('wiki <verb> [args]');
  console.error('');
  for (const section of SECTIONS) {
    const verbs = VERBS.filter((v) => v.section === section);
    if (!verbs.length) continue;
    const sectionHeader = {
      'SQL': 'SQL (DuckDB analytical view — ad-hoc queries over wiki/*.md frontmatter)',
      'REPLAY': 'REPLAY (re-run captured Telegram-driven ingests — catch persona/CLI drift)',
      'REVIEW': 'REVIEW (discovery + health digest — run weekly-ish)',
      'MEASUREMENTS': 'MEASUREMENTS (tabular time-series — growth, BP, fitness, labs)',
    }[section] || section;
    console.error(sectionHeader);
    for (const v of verbs) for (const l of v.lines) console.error(l);
    console.error('');
  }
  console.error(`vault: ${VAULT_ROOT}`);
}

function printVerbHelp(name) {
  const v = VERBS.find((x) => x.name === name);
  if (!v) { printGlobalHelp(); return; }
  if (v.longHelp) {
    console.error(v.longHelp);
  } else {
    // Fallback: just the synopsis lines.
    console.error(`wiki ${name} — (no detailed help; see CLAUDE.md and SCHEMA.md)`);
    console.error('');
    for (const l of v.lines) console.error(l);
  }
}

const verb = process.argv[2];
const args = parseArgs(process.argv.slice(3));
const cmds = {
  // read
  list: cmdList, search: cmdSearch, recent: cmdRecent, print: cmdPrint,
  sources: cmdSources, related: cmdRelated,
  preview: cmdPreview, context: cmdContext, agenda: cmdAgenda,
  // write
  write: cmdWrite, link: cmdLink, mv: cmdMv, delete: cmdDelete, patch: cmdPatch, merge: cmdMerge,
  ingest: cmdIngest,
  // graph + navigation
  links: cmdLinks, backlinks: cmdBacklinks,
  relations: cmdRelations, observations: cmdObservations,
  autolink: cmdAutolink,
  resolve: cmdResolve, path: cmdPath, hubs: cmdHubs, place: cmdPlace, stubs: cmdStubs,
  timeline: cmdTimeline,
  // todo
  todo: cmdTodo,
  // hygiene
  lint: cmdLint, reindex: cmdReindex, 'sync-ids': cmdSyncIds, size: cmdSize, groom: cmdGroom, audit: cmdAudit,
  'persona-lint': cmdPersonaLint, migrate: cmdMigrate, preflight: cmdPreflight,
  // measurements (tabular time-series)
  measure: cmdMeasure,
  // review (discovery + health digest)
  review: cmdReview,
  // replay (B2 — re-run captured Telegram-driven specs)
  replay: cmdReplay,
  // SQL (DuckDB analytical view)
  sql: cmdSql,
  // git
  diff: cmdDiff, revert: cmdRevert,
};

// --help on a known verb prints per-verb help (M11); falls through to global
// help for `wiki --help`, no verb, or unknown verb.
if (verb && args.help && cmds[verb]) {
  printVerbHelp(verb);
  process.exit(0);
}
if (!verb || !cmds[verb]) {
  printGlobalHelp();
  process.exit(1);
}

// Per-verb flag-rename / removal policy (M14). Entries are added here when a
// CLI flag is renamed or removed in a release; the deprecation cycle is documented
// in CONTRIBUTING.md § "Flag-rename policy" (vX.Y warns, vX.(Y+1) errors).
// Shape: { <verb>: { <old-flag>: '<new-flag>' | null } }. Empty by default.
const FLAG_ALIASES = {
  // example: write: { soft: 'lenient' },
};
{
  const { warnings, errors } = applyFlagAliases(verb, args, FLAG_ALIASES);
  for (const w of warnings) console.error(`[deprecated] wiki ${verb}: ${w}`);
  if (errors.length) {
    for (const e of errors) console.error(`error: wiki ${verb}: ${e}`);
    process.exit(1);
  }
}

// Global flag: --no-auto-commit. Honored across every write verb by setting
// the env var that autoCommitDisabled() reads. Equivalent to invoking with
// WIKI_NO_AUTO_COMMIT=1 in the shell. Removed from args before dispatch so
// per-verb arg parsers don't see it.
if (args['no-auto-commit']) {
  process.env.WIKI_NO_AUTO_COMMIT = '1';
  delete args['no-auto-commit'];
}

// Tamper check: run BEFORE write-class verbs so users see bypass writes
// before they're folded into the next auto-commit.
const WRITE_VERBS = new Set(['write', 'patch', 'ingest', 'mv', 'delete', 'merge', 'link', 'autolink', 'groom', 'todo']);
if (WRITE_VERBS.has(verb)) tamperCheck();

cmds[verb](args);
