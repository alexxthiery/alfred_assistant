  console.error('  revert [<commit>|HEAD]                    revert a commit (refuses if working tree dirty)');
  console.error('  (auto-commit batches all dirty files into one commit; revert may undo more than expected)');
  console.error('');
  console.error(`vault: ${VAULT_ROOT}`);
  process.exit(1);
}

// Tamper check: run BEFORE write-class verbs so users see bypass writes
// before they're folded into the next auto-commit.
const WRITE_VERBS = new Set(['write', 'patch', 'ingest', 'mv', 'delete', 'merge', 'link', 'autolink', 'groom', 'todo']);
if (WRITE_VERBS.has(verb)) tamperCheck();

cmds[verb](args);
