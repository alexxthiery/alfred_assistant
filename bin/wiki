  { name: '__global', section: 'GLOBAL FLAGS', lines: [
    '  --no-auto-commit                          skip the post-write git commit (or set WIKI_NO_AUTO_COMMIT=1)',
    '  <verb> --help                             show detailed help for a verb (where available)',
