// Thin path-binding wrapper. The actual memoization (with mtime invalidation)
// lives in `bin/lib/schema.js::loadSchema` per HR22 / audit/14 §
// schema-load-redundancy. A single CLI invocation parses SCHEMA.md once even
// when validateForWrite + validateBody + postWriteAudit each call this.
const loadSchema = () => _loadSchema(SCHEMA_PATH);

// ─── frontmatter ───────────────────────────────────────────────────────────
// parseFrontmatter, serializeFrontmatter, migratePage and the schema-version
