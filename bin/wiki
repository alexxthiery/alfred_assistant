#!/usr/bin/env node
// wiki — verb CLI for Karpathy-style personal knowledge vaults.
//
// Read:  list, search, recent, print, sources, related
// Write: write, link, mv, delete
// Todo:  todo {add,list,update,classify,done,reopen,abandon,defer}
// Graph: links, backlinks, relations, observations, autolink
// Health: lint, sync-ids, size, reindex
//
// Auto-maintained: wiki/index.md, wiki/log.md
// Schema-aware: rejects unknown tags/types, refuses forbidden aggregator slugs.
// No deps. Node stdlib only.

const fs = require('fs');
const path = require('path');
const { SCHEMA_MIGRATIONS } = require('./lib/frontmatter.js');
const { SECTIONS, VERBS, WRITE_VERBS } = require('./lib/verb-metadata.js');

const { applyFlagAliases } = require('./lib/flag-aliases.js');

const { knownFlags, unknownFlags, valuelessFlags, GLOBAL_FLAGS } = require('./lib/flag-spec.js');
const { VAULT_ROOT } = require('./lib/vault.js');

const {
  cmdList, cmdSearch, cmdRecent, cmdPreview, cmdPrint,
  cmdSources, cmdRelated, cmdUnlinkedMentions, cmdAgenda, cmdDay, cmdContext, cmdChallenge, cmdRender,
} = require('./verbs/read.js');
const { cmdSql } = require('./commands/sql.js');
const { cmdLint } = require('./commands/lint.js');
const { cmdReview } = require('./commands/review.js');
const { cmdWrite } = require('./commands/write.js');
const { cmdLink, cmdMv, cmdDelete, cmdMerge } = require('./commands/edit.js');
const { cmdPatch } = require('./commands/patch.js');
const { cmdIngest } = require('./commands/ingest.js');
const { cmdPredict, cmdHypothesize, cmdCapture } = require('./commands/epistemic.js');
const { cmdTodo } = require('./commands/todo.js');
const { cmdMeasure } = require('./commands/measure.js');
const { cmdReplay } = require('./commands/replay.js');
const { cmdDiff, cmdRevert } = require('./commands/git.js');
const { cmdBless, cmdAudit, cmdFixLinks, cmdGroom, cmdSize, cmdSyncIds, cmdReindex, cmdPreflight, cmdMigrate } = require('./commands/hygiene.js');
const { cmdJobs } = require('./commands/jobs.js');
const { cmdLinks, cmdBacklinks, cmdRelations, cmdObservations, cmdAutolink, cmdResolve, cmdPath, cmdHubs, cmdHooks, cmdProcess, cmdTimeline, cmdStubs, cmdPlace } = require('./commands/graph.js');

const { tamperCheck } = require('./lib/page-io.js');

// ─── persona-lint: catch verb drift between docs and the dispatch map ─────
//
// Greps a fixed set of doc files for `wiki <verb>` references. Any verb not
// in the live dispatch map (`cmds`) is flagged. Reports unknown flags on
// `wiki <verb> --flag` mentions only when the verb itself is known.
//
// Files scanned (all paths relative to VAULT_ROOT; missing files skipped):
//   - SCHEMA.md
//   - alfred/_persona.md, alfred/_persona.local.md
//   - docs/PERSONA.template.md, docs/persona/*.template.md
//   - docs/SCHEMA.md, docs/NANOCLAW-PATCHES.md
//   - README.md, CONTRIBUTING.md, CHANGELOG.md
//
// Exits 0 if clean, 2 if any unknown verb was found.
function cmdPersonaLint(args) {
  const candidates = [
    'CLAUDE.md',
    'SCHEMA.md',
    'AGENTS.md',
    'AGENTS.local.md',
    'persona/pipeline.md',
    'persona/routines.md',
    'persona/examples.md',
    'alfred/_persona.md',
    'alfred/_persona.local.md',
    'docs/PERSONA.template.md',
    'docs/SCHEMA.md',
    'docs/NANOCLAW-PATCHES.md',
    'docs/WEEKLY-DIGEST.md',
    'docs/CONVENTIONS.md',
    'docs/PHILOSOPHY.md',
    'README.md',
    'CONTRIBUTING.md',
    'CHANGELOG.md',
  ];

  const personaDir = path.join(VAULT_ROOT, 'docs', 'persona');
  if (fs.existsSync(personaDir)) {
    for (const file of fs.readdirSync(personaDir).sort()) {
      if (file.endsWith('.md')) candidates.push(path.join('docs', 'persona', file));
    }
  }

  // Need cmds in scope — it's declared at the bottom of the file as a
  // module-level const, hoisted at parse but only initialized after function
  // definitions run. By the time cmdPersonaLint is invoked, cmds exists.
  const knownVerbs = new Set(Object.keys(cmds));

  let scanned = 0;
  const hits = []; // { docRel, line, verb }
  for (const rel of candidates) {
    const p = path.join(VAULT_ROOT, rel);
    if (!fs.existsSync(p)) continue;
    scanned++;
    const text = fs.readFileSync(p, 'utf-8');
    const lines = text.split('\n');
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      // Only flag backtick-wrapped `wiki <verb>` — prose mentions of "wiki" as a
      // noun (e.g. "the wiki is...", "wiki page", "the wiki via X") would otherwise
      // generate false positives. Doc convention here is to wrap CLI invocations
      // in code spans, so backticks are a reliable signal.
      const re = /`wiki ([a-z][a-z0-9-]*)/g;
      let m;
      const seen = new Set();
      while ((m = re.exec(line)) !== null) {
        const v = m[1];
        if (!v) continue;
        if (seen.has(v)) continue;
        seen.add(v);
        if (!knownVerbs.has(v)) {
          hits.push({ docRel: rel, line: i + 1, verb: v });
        }
      }
    }
  }

  if (scanned === 0) {
    console.error('persona-lint: no candidate docs found under ' + VAULT_ROOT);
    process.exit(1);
  }
  if (hits.length === 0) {
    console.log(`persona-lint: clean (${scanned} doc${scanned === 1 ? '' : 's'} scanned, ${knownVerbs.size} known verbs)`);
    process.exit(0);
  }
  console.error(`persona-lint: ${hits.length} unknown verb reference${hits.length === 1 ? '' : 's'}:`);
  for (const h of hits) {
    console.error(`  ${h.docRel}:${h.line}  \`wiki ${h.verb}\`  (not in dispatch map)`);
  }
  console.error('');
  console.error('Fix: either rename the doc reference to a real verb, OR add the verb to the dispatch map.');
  process.exit(2);
}

// ─── argparse + dispatch ───────────────────────────────────────────────────

function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const body = a.slice(2);
      const eqIdx = body.indexOf('=');
      if (eqIdx > 0) {
        out[body.slice(0, eqIdx)] = body.slice(eqIdx + 1);
        continue;
      }
      const key = body;
      const next = argv[i + 1];
      if (next !== undefined && !next.startsWith('--')) { out[key] = next; i++; }
      else out[key] = true;
    } else {
      out._.push(a);
    }
  }
  return out;
}

// ─── help system (M10 + M11) ───────────────────────────────────────────────
// Command help metadata lives in bin/lib/verb-metadata.js so docs, tests,
// validation, and dispatch wiring can share one command surface.

function printGlobalHelp() {
  console.error('wiki <verb> [args]');
  console.error('');
  for (const section of SECTIONS) {
    const verbs = VERBS.filter((v) => v.section === section);
    if (!verbs.length) continue;
    const sectionHeader = {
      'SQL': 'SQL (DuckDB analytical view — ad-hoc queries over three tables: vault, observations, relations)',
      'REPLAY': 'REPLAY (re-run captured Telegram-driven ingests — catch persona/CLI drift)',
      'REVIEW': 'REVIEW (discovery + health digest — run weekly-ish)',
      'MEASUREMENTS': 'MEASUREMENTS (tabular time-series — growth, BP, fitness, labs)',
    }[section] || section;
    console.error(sectionHeader);
    for (const v of verbs) for (const l of v.lines) console.error(l);
    console.error('');
  }
  console.error(`vault: ${VAULT_ROOT}`);
}

function printVerbHelp(name) {
  const v = VERBS.find((x) => x.name === name);
  if (!v) { printGlobalHelp(); return; }
  if (v.longHelp) {
    console.error(v.longHelp);
  } else {
    // Fallback: just the synopsis lines.
    console.error(`wiki ${name} — (no detailed help; see CLAUDE.md and SCHEMA.md)`);
    console.error('');
    for (const l of v.lines) console.error(l);
  }
}

const verb = process.argv[2];
const args = parseArgs(process.argv.slice(3));
const cmds = {
  // read
  list: cmdList, search: cmdSearch, recent: cmdRecent, print: cmdPrint,
  sources: cmdSources, related: cmdRelated, 'unlinked-mentions': cmdUnlinkedMentions, render: cmdRender,
  preview: cmdPreview, context: cmdContext, agenda: cmdAgenda, day: cmdDay, challenge: cmdChallenge,
  // write
  write: cmdWrite, link: cmdLink, mv: cmdMv, delete: cmdDelete, patch: cmdPatch, merge: cmdMerge,
  ingest: cmdIngest,
  predict: cmdPredict, hypothesize: cmdHypothesize, capture: cmdCapture,
  // graph + navigation
  links: cmdLinks, backlinks: cmdBacklinks,
  relations: cmdRelations, observations: cmdObservations,
  autolink: cmdAutolink,
  resolve: cmdResolve, path: cmdPath, hubs: cmdHubs, place: cmdPlace, stubs: cmdStubs,
  hooks: cmdHooks, process: cmdProcess,
  timeline: cmdTimeline,
  // todo
  todo: cmdTodo,
  // hygiene
  lint: cmdLint, reindex: cmdReindex, 'sync-ids': cmdSyncIds, size: cmdSize, groom: cmdGroom, audit: cmdAudit,
  'fix-links': cmdFixLinks,
  'persona-lint': cmdPersonaLint, migrate: cmdMigrate, preflight: cmdPreflight, bless: cmdBless,
  // measurements (tabular time-series)
  measure: cmdMeasure,
  // review (discovery + health digest)
  review: cmdReview,
  // replay (B2 — re-run captured Telegram-driven specs)
  replay: cmdReplay,
  // SQL (DuckDB analytical view)
  sql: cmdSql,
  // git
  diff: cmdDiff, revert: cmdRevert,
  // scheduling (observability + config validation; OS launchd/cron is the executor)
  jobs: cmdJobs,
};

// --help on a known verb prints per-verb help (M11); falls through to global
// help for `wiki --help`, no verb, or unknown verb.
if (verb && args.help && cmds[verb]) {
  printVerbHelp(verb);
  process.exit(0);
}
if (!verb || !cmds[verb]) {
  printGlobalHelp();
  process.exit(1);
}

// Per-verb flag-rename / removal policy (M14). Entries are added here when a
// CLI flag is renamed or removed in a release; the deprecation cycle is documented
// in CONTRIBUTING.md § "Flag-rename policy" (vX.Y warns, vX.(Y+1) errors).
// Shape: { <verb>: { <old-flag>: '<new-flag>' | null } }. Empty by default.
const FLAG_ALIASES = {
  // example: write: { soft: 'lenient' },
};
{
  const { warnings, errors } = applyFlagAliases(verb, args, FLAG_ALIASES);
  for (const w of warnings) console.error(`[deprecated] wiki ${verb}: ${w}`);
  if (errors.length) {
    for (const e of errors) console.error(`error: wiki ${verb}: ${e}`);
    process.exit(1);
  }
}

// Strict flag validation. parseArgs accepts any `--flag`; without this a verb
// silently ignores flags it does not read (typos, unsupported flags, or a flag
// meant for another verb), e.g. `wiki list --limit` did nothing. Reject unknown
// flags loudly. The known set (help-advertised + global + shared write-core
// family) is kept complete against the code by tests/unit/flag-parity.test.js,
// so this never rejects a flag the verb actually honors. Runs after alias
// rewriting so deprecated flags are normalized first.
{
  const v = VERBS.find((e) => e.name === verb);
  const helpText = v ? [...(v.lines || []), v.longHelp || ''].join('\n') : '';
  const unknown = unknownFlags(verb, args, helpText);
  if (unknown.length) {
    const plural = unknown.length > 1 ? 's' : '';
    console.error(`error: wiki ${verb}: unknown flag${plural} ${unknown.map((f) => '--' + f).join(', ')}`);
    const known = [...knownFlags(verb, helpText)]
      .filter((f) => !GLOBAL_FLAGS.has(f))
      .sort();
    if (known.length) console.error(`  known flags: ${known.map((f) => '--' + f).join(' ')}`);
    console.error(`  run \`wiki ${verb} --help\` for usage`);
    process.exit(2);
  }
}

// Value-required flags passed with no value. parseArgs makes `--title` (no
// value) into title=true, which the write path would persist as the string
// "true". Reject loudly instead of silently corrupting the page. The set is
// conservative (boolean flags are never listed), so this cannot reject a valid
// bare flag like --soft.
{
  const valueless = valuelessFlags(args);
  if (valueless.length) {
    const plural = valueless.length > 1 ? 's' : '';
    console.error(`error: wiki ${verb}: flag${plural} ${valueless.map((f) => '--' + f).join(', ')} require${plural ? '' : 's'} a value`);
    process.exit(2);
  }
}

// Global flag: --no-auto-commit. Honored across every write verb by setting
// the env var the page-io auto-commit path reads. Equivalent to invoking with
// WIKI_NO_AUTO_COMMIT=1 in the shell. Removed from args before dispatch so
// per-verb arg parsers don't see it.
if (args['no-auto-commit']) {
  process.env.WIKI_NO_AUTO_COMMIT = '1';
  delete args['no-auto-commit'];
}

// Tamper check: run BEFORE write-class verbs so users see bypass writes
// before they're folded into the next auto-commit.
// `todo` is write-class, but its `list` subcommand is read-only — tamper-
// checking it would block a pure read on a dirty vault (e.g. the reminder
// dispatcher's `todo list --reminders` failing → reminders silently don't
// fire). Exempt the read-only subcommand; todo writes still check.
const isReadOnlyTodo = (verb === 'todo' && args._[0] === 'list');
if (WRITE_VERBS.has(verb) && !isReadOnlyTodo) tamperCheck({ accept: !!args['accept-tamper'] });
// --accept-tamper means "fold the accepted out-of-band edit into this write's
// commit" — so this invocation's auto-commit must stage everything, not just
// the scoped wiki/raw paths (the edit may be a stray root file).
if (args['accept-tamper']) process.env.WIKI_AUTOCOMMIT_STAGE_ALL = '1';

cmds[verb](args);
