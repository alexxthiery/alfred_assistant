  { name: 'persona-lint', section: 'HYGIENE', lines: ['  persona-lint                              grep persona/schema/docs for unknown `wiki <verb>` references'] },
  { name: 'migrate',      section: 'HYGIENE', lines: ['  migrate [<slug>] [--dry-run]              apply pending SCHEMA_MIGRATIONS; stamps schema_version on unversioned pages'] },
  { name: 'preflight',    section: 'HYGIENE', lines: ['  preflight                                 smoke-test node/git/SCHEMA.md/duckdb/curl/SMTP/audit; one-command go/no-go'] },

  // SQL
  { name: 'sql', section: 'SQL', lines: [
    '  sql "<query>" [--tsv|--csv|--json]        run SQL against the three tables (DuckDB); machine-parseable output modes',
    '  sql --schema                              DESCRIBE all three tables + column gloss',
    '  sql --explore                             open the DuckDB REPL on the DB',
    '  (DB at .cache/vault.duckdb; rebuilt lazily when any wiki/*.md is newer)',
  ], longHelp: [
    'wiki sql — ad-hoc DuckDB queries over the vault.',
    '',
    'Three tables, joinable by slug:',
    '  vault         one row per page. Columns include slug, title, type, tags,',
    '                aliases, n_facts/n_hypotheses/n_predictions/n_questions/...',
    '                (denormalized counts, derivable from observations),',
    '                frontmatter passthroughs (born, visibility, sensitive,',
    '                confidence, decided_on, status, due, when_), mention_count.',
    '                NOTE: `when_` is the renamed `when` frontmatter (SQL reserves',
    '                `when`); use `when_` in queries.',
    '  observations  one row per body bullet ([fact]/[hypothesis]/[prediction]/etc).',
    '                Columns: slug, category, body (cleaned, no date/prov tags),',
    '                superseded, since, until, as_of, on_date, by_date, confidence,',
    '                provenance (varchar[]).',
    '  relations     one row per "- verb [[target]]" relation.',
    '                Columns: slug, verb, target.',
    '',
    'Canonical join keys:',
    '  observations.slug = vault.slug',
    '  relations.slug    = vault.slug   (and relations.target = vault.slug)',
    '',
    'Common patterns:',
    '  # Predictions past resolution date that haven\'t been superseded',
    '  SELECT slug, body, by_date, confidence FROM observations',
    '   WHERE category=\'prediction\' AND by_date < current_date AND NOT superseded;',
    '',
    '  # People not touched in 6 months (latent reconnection)',
    '  SELECT slug FROM vault',
    '   WHERE type=\'entity\' AND list_contains(tags, \'person\')',
    '     AND updated < current_date - INTERVAL 180 DAY;',
    '',
    '  # Relation histogram (which verbs dominate?)',
    '  SELECT verb, COUNT(*) n FROM relations GROUP BY verb ORDER BY n DESC;',
    '',
    'Prefer this verb over asking for a new verb whenever a query expresses the',
    'need. New verbs are reserved for actions, not for read-only filters.',
  ].join('\n') },

  // REPLAY
  { name: 'replay', section: 'REPLAY', lines: [
    '  replay <msg-id>                           re-run captured spec, diff vs captured result',
    '  replay --all                              walk all captures, summarize stable/drift',
    '  (captures live at raw/telegram-replay/<YYYY-MM>/ — auto-written when spec.msg_id is set)',
  ] },

  // REVIEW
  { name: 'review', section: 'REVIEW', lines: [
    '  review                                    Markdown digest of:',
    '                                            (1) independent mentions (promotion candidates)',
    '                                            (2) co-occurring slugs with no typed relation',
    '                                            (3) concept anchors missing (heavily-used tag, no canonical page)',
    '                                            (4) stale `[as-of]` / past-due `[until]` markers',
    '                                            (5) decisions without rationale',
    '                                            (6) orphan sources (ingested, never referenced)',
    '                                            (7) stale open todos (>60 days)',
  ] },

  // MEASUREMENTS
  { name: 'measure', section: 'MEASUREMENTS', lines: [
    '  measure <series> --date YYYY-MM-DD --field=value [...]',
    '                                           append a row to raw/measurements/<series>.tsv',
    '                                           and re-render the matching wiki page.',
    '                                           auto-derives bmi from height_m+weight_kg, age from --birth.',
    '  (pages with frontmatter `source_file:` cannot be patched/written — use this verb.)',
  ] },

  // GIT
  { name: 'diff',   section: 'GIT', lines: ['  diff [--since "spec"]                     show recent commits (default: 24h)'] },
  { name: 'revert', section: 'GIT', lines: [
    '  revert [<commit>|HEAD]                    revert a commit (refuses if working tree dirty)',
    '  (auto-commit batches all dirty files into one commit; revert may undo more than expected)',
  ] },

  { name: 'jobs', section: 'SCHEDULING', lines: [
    '  jobs [--check] [--json]                   list scheduled jobs (daily-brief, reminders, backup, weekly);',
    '  (--check validates installed launchd/cron vs the manifest; OS stays the executor, never edited here)',
  ] },

  // GLOBAL FLAGS (not real verbs; rendered last)
  { name: '__global', section: 'GLOBAL FLAGS', lines: [
    '  --no-auto-commit                          skip the post-write git commit (or set WIKI_NO_AUTO_COMMIT=1)',
    '  <verb> --help                             show detailed help for a verb (where available)',
  ] },
];

function printGlobalHelp() {
  console.error('wiki <verb> [args]');
  console.error('');
  for (const section of SECTIONS) {
    const verbs = VERBS.filter((v) => v.section === section);
    if (!verbs.length) continue;
    const sectionHeader = {
      'SQL': 'SQL (DuckDB analytical view — ad-hoc queries over three tables: vault, observations, relations)',
      'REPLAY': 'REPLAY (re-run captured Telegram-driven ingests — catch persona/CLI drift)',
      'REVIEW': 'REVIEW (discovery + health digest — run weekly-ish)',
      'MEASUREMENTS': 'MEASUREMENTS (tabular time-series — growth, BP, fitness, labs)',
    }[section] || section;
    console.error(sectionHeader);
    for (const v of verbs) for (const l of v.lines) console.error(l);
    console.error('');
  }
  console.error(`vault: ${VAULT_ROOT}`);
}

function printVerbHelp(name) {
  const v = VERBS.find((x) => x.name === name);
  if (!v) { printGlobalHelp(); return; }
  if (v.longHelp) {
    console.error(v.longHelp);
  } else {
    // Fallback: just the synopsis lines.
    console.error(`wiki ${name} — (no detailed help; see CLAUDE.md and SCHEMA.md)`);
    console.error('');
    for (const l of v.lines) console.error(l);
  }
}

const verb = process.argv[2];
const args = parseArgs(process.argv.slice(3));
const cmds = {
  // read
  list: cmdList, search: cmdSearch, recent: cmdRecent, print: cmdPrint,
  sources: cmdSources, related: cmdRelated, 'unlinked-mentions': cmdUnlinkedMentions, render: cmdRender,
  preview: cmdPreview, context: cmdContext, agenda: cmdAgenda, day: cmdDay, challenge: cmdChallenge,
  // write
  write: cmdWrite, link: cmdLink, mv: cmdMv, delete: cmdDelete, patch: cmdPatch, merge: cmdMerge,
  ingest: cmdIngest,
  predict: cmdPredict, hypothesize: cmdHypothesize, capture: cmdCapture,
  // graph + navigation
  links: cmdLinks, backlinks: cmdBacklinks,
  relations: cmdRelations, observations: cmdObservations,
  autolink: cmdAutolink,
  resolve: cmdResolve, path: cmdPath, hubs: cmdHubs, place: cmdPlace, stubs: cmdStubs,
  hooks: cmdHooks, process: cmdProcess,
  timeline: cmdTimeline,
  // todo
  todo: cmdTodo,
  // hygiene
  lint: cmdLint, reindex: cmdReindex, 'sync-ids': cmdSyncIds, size: cmdSize, groom: cmdGroom, audit: cmdAudit,
  'fix-links': cmdFixLinks,
  'persona-lint': cmdPersonaLint, migrate: cmdMigrate, preflight: cmdPreflight, bless: cmdBless,
  // measurements (tabular time-series)
  measure: cmdMeasure,
  // review (discovery + health digest)
  review: cmdReview,
  // replay (B2 — re-run captured Telegram-driven specs)
  replay: cmdReplay,
  // SQL (DuckDB analytical view)
  sql: cmdSql,
  // git
  diff: cmdDiff, revert: cmdRevert,
  // scheduling (observability + config validation; OS launchd/cron is the executor)
  jobs: cmdJobs,
};

// --help on a known verb prints per-verb help (M11); falls through to global
// help for `wiki --help`, no verb, or unknown verb.
if (verb && args.help && cmds[verb]) {
  printVerbHelp(verb);
  process.exit(0);
}
if (!verb || !cmds[verb]) {
  printGlobalHelp();
  process.exit(1);
}

// Per-verb flag-rename / removal policy (M14). Entries are added here when a
// CLI flag is renamed or removed in a release; the deprecation cycle is documented
// in CONTRIBUTING.md § "Flag-rename policy" (vX.Y warns, vX.(Y+1) errors).
// Shape: { <verb>: { <old-flag>: '<new-flag>' | null } }. Empty by default.
const FLAG_ALIASES = {
  // example: write: { soft: 'lenient' },
};
{
  const { warnings, errors } = applyFlagAliases(verb, args, FLAG_ALIASES);
  for (const w of warnings) console.error(`[deprecated] wiki ${verb}: ${w}`);
  if (errors.length) {
    for (const e of errors) console.error(`error: wiki ${verb}: ${e}`);
    process.exit(1);
  }
}

// Strict flag validation. parseArgs accepts any `--flag`; without this a verb
// silently ignores flags it does not read (typos, unsupported flags, or a flag
// meant for another verb), e.g. `wiki list --limit` did nothing. Reject unknown
// flags loudly. The known set (help-advertised + global + shared write-core
// family) is kept complete against the code by tests/unit/flag-parity.test.js,
// so this never rejects a flag the verb actually honors. Runs after alias
// rewriting so deprecated flags are normalized first.
{
  const v = VERBS.find((e) => e.name === verb);
  const helpText = v ? [...(v.lines || []), v.longHelp || ''].join('\n') : '';
  const unknown = unknownFlags(verb, args, helpText);
  if (unknown.length) {
    const plural = unknown.length > 1 ? 's' : '';
    console.error(`error: wiki ${verb}: unknown flag${plural} ${unknown.map((f) => '--' + f).join(', ')}`);
    const known = [...knownFlags(verb, helpText)]
      .filter((f) => !GLOBAL_FLAGS.has(f))
      .sort();
    if (known.length) console.error(`  known flags: ${known.map((f) => '--' + f).join(' ')}`);
    console.error(`  run \`wiki ${verb} --help\` for usage`);
    process.exit(2);
  }
}

// Value-required flags passed with no value. parseArgs makes `--title` (no
// value) into title=true, which the write path would persist as the string
// "true". Reject loudly instead of silently corrupting the page. The set is
// conservative (boolean flags are never listed), so this cannot reject a valid
// bare flag like --soft.
{
  const valueless = valuelessFlags(args);
  if (valueless.length) {
    const plural = valueless.length > 1 ? 's' : '';
    console.error(`error: wiki ${verb}: flag${plural} ${valueless.map((f) => '--' + f).join(', ')} require${plural ? '' : 's'} a value`);
    process.exit(2);
  }
}

// Global flag: --no-auto-commit. Honored across every write verb by setting
// the env var the page-io auto-commit path reads. Equivalent to invoking with
// WIKI_NO_AUTO_COMMIT=1 in the shell. Removed from args before dispatch so
// per-verb arg parsers don't see it.
if (args['no-auto-commit']) {
  process.env.WIKI_NO_AUTO_COMMIT = '1';
  delete args['no-auto-commit'];
}

// Tamper check: run BEFORE write-class verbs so users see bypass writes
// before they're folded into the next auto-commit.
const WRITE_VERBS = new Set(['write', 'patch', 'ingest', 'mv', 'delete', 'merge', 'link', 'autolink', 'groom', 'todo']);
// `todo` is write-class, but its `list` subcommand is read-only — tamper-
// checking it would block a pure read on a dirty vault (e.g. the reminder
// dispatcher's `todo list --reminders` failing → reminders silently don't
// fire). Exempt the read-only subcommand; todo add/done/defer still check.
const isReadOnlyTodo = (verb === 'todo' && args._[0] === 'list');
if (WRITE_VERBS.has(verb) && !isReadOnlyTodo) tamperCheck({ accept: !!args['accept-tamper'] });
// --accept-tamper means "fold the accepted out-of-band edit into this write's
// commit" — so this invocation's auto-commit must stage everything, not just
// the scoped wiki/raw paths (the edit may be a stray root file).
if (args['accept-tamper']) process.env.WIKI_AUTOCOMMIT_STAGE_ALL = '1';

cmds[verb](args);
