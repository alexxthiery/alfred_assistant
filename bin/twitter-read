#!/usr/bin/env node
'use strict';

const { spawnSync } = require('child_process');
const {
  TwitterReadError,
  buildTwitterReadInvocation,
  formatTwitterReadHelp,
} = require('./lib/twitter-read.js');

const args = process.argv.slice(2);

if (args.length === 0 || args[0] === '-h' || args[0] === '--help') {
  console.log(formatTwitterReadHelp());
  process.exit(0);
}

let invocation;
try {
  invocation = buildTwitterReadInvocation(args);
} catch (err) {
  if (err instanceof TwitterReadError) {
    console.error(`twitter-read: ${err.message}`);
    if (err.hint) console.error(`hint: ${err.hint}`);
    process.exit(err.exitCode);
  }
  throw err;
}

const r = spawnSync(invocation.bin, invocation.args, {
  stdio: 'inherit',
  env: process.env,
});

if (r.error) {
  console.error(`twitter-read: failed to exec ${invocation.bin}: ${r.error.message}`);
  process.exit(4);
}

if (typeof r.status === 'number') process.exit(r.status);
process.exit(4);
